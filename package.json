{
  "name": "nikos-agent-stack",
  "version": "1.0.0",
  "description": "niko's deterministic omp delivery gates, native orchestration engine, advisor, and questionnaire tooling",
  "type": "module",
  "keywords": [
    "omp",
    "omp-plugin",
    "omp-extension",
    "delivery-gates",
    "gate-checker",
    "ask-questionnaire",
    "advisor",
    "agent-orchestration",
    "durable-workflows",
    "omnipotence"
  ],
  "homepage": "https://github.com/nikos-repos/nikos-agent-stack#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nikos-repos/nikos-agent-stack.git"
  },
  "bugs": {
    "url": "https://github.com/nikos-repos/nikos-agent-stack/issues"
  },
  "engines": {
    "bun": ">=1.2.22"
  },
  "bin": {
    "nikos-gates": "gate-checker/gate-cli.js",
    "omnipotence": "orchestration/cli.ts"
  },
  "exports": {
    "./gate-cli": "./gate-checker/gate-cli.js",
    "./omnipotence": "./orchestration/api.ts"
  },
  "omp": {
    "extensions": [
      "./gate-checker/index.ts",
      "./orchestration/index.ts",
      "./ask-questionnaire/index.ts"
    ]
  },
  "files": [
    "gate-checker/index.ts",
    "gate-checker/gate-cli.js",
    "gate-checker/predicates.js",
    "gate-checker/ledger.js",
    "gate-checker/frustrations.js",
    "gate-checker/config.js",
    "gate-checker/scope.js",
    "gate-checker/lease.js",
    "gate-checker/risks.js",
    "gate-checker/provenance.js",
    "gate-checker/journal.js",
    "orchestration/index.ts",
    "orchestration/cli.ts",
    "orchestration/api.ts",
    "orchestration/contracts.ts",
    "orchestration/store.ts",
    "orchestration/engine.ts",
    "orchestration/hooks.ts",
    "orchestration/profiles.ts",
    "orchestration/blueprints.ts",
    "orchestration/loader.ts",
    "orchestration/processes.ts",
    "docs/omnipotence-user-guide.md",
    "ask-questionnaire/index.ts",
    "advisor/install.js",
    "advisor/WATCHDOG.yml",
    "README.md"
  ],
  "scripts": {
    "test": "bun test gate-checker/*.test.ts ask-questionnaire/*.test.ts orchestration/*.test.ts plugin.test.ts && bun run gate-checker/wiring-check.ts"
  }
}
