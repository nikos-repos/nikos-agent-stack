{
  "name": "advisor-present",
  "setup": [
    "create('advisor-present')",
    "run HARNESS_AGENT=main, then resume the root session so native restore registers its persisted advisor transcript"
  ],
  "settings": {
    "async": {
      "enabled": false
    },
    "advisor": {
      "enabled": true
    }
  },
  "agents": [
    "advisor: advisor true, blocking true"
  ],
  "expected": [
    "native restore of the root session registers a parked kind: advisor ref from its advisor transcript",
    "the observer excludes that advisor ref while retaining ordinary task-child rows"
  ],
  "turns": {
    "main": [
      {
        "calls": [
          {
            "tool": "task",
            "args": {
              "context": "Ask the advisor",
              "tasks": [
                {
                  "name": "advisor-child",
                  "agent": "advisor",
                  "task": "HARNESS_AGENT=child/advisor advise.",
                  "solutionSpace": "One recommendation."
                }
              ]
            }
          }
        ]
      },
      {
        "text": "advisor complete"
      }
    ],
    "child/advisor": [
      {
        "text": "advisor recommendation",
        "calls": [
          {
            "tool": "yield",
            "args": {
              "type": "result"
            }
          }
        ]
      }
    ]
  }
}
