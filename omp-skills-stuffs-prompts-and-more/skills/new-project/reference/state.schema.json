{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.factory/schemas/state.schema.json",
  "title": "factory run state",
  "description": "the durable truth of one factory run. written by new-project after every gate, wave, and blocker. a resume reads this file and nothing else.",
  "type": "object",
  "required": ["schema_version", "project", "phase", "status", "updated_at", "gates", "artifacts", "waves", "blockers"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "1.0" },

    "project": {
      "type": "object",
      "required": ["id", "root"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "root": { "type": "string", "minLength": 1 },
        "remote": { "type": "string" }
      }
    },

    "phase": {
      "type": "string",
      "enum": ["discovery", "recon", "thesis", "requirements", "architecture", "taskgraph", "execution", "finish"]
    },

    "status": {
      "type": "string",
      "enum": ["active", "awaiting-approval", "blocked", "cancelled", "complete"]
    },

    "updated_at": { "type": "string", "format": "date-time" },

    "gates": {
      "type": "array",
      "description": "one record per gate decision. approval lives here and nowhere else; a file on disk is never evidence of approval.",
      "items": {
        "type": "object",
        "required": ["gate", "decision", "decided_at"],
        "additionalProperties": false,
        "properties": {
          "gate": {
            "type": "string",
            "enum": [
              "research-permission",
              "thesis",
              "requirements",
              "architecture",
              "wave-0",
              "repo-create",
              "push",
              "worktree-cleanup"
            ],
            "description": "thesis, requirements, architecture, and wave-0 are product decision gates. research-permission, repo-create, push, and worktree-cleanup are point-of-risk approvals, not product gates."
          },
          "decision": { "type": "string", "enum": ["approved", "rejected", "revised", "stopped", "pivoted"] },
          "decided_at": { "type": "string", "format": "date-time" },
          "artifact_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "note": { "type": "string", "description": "the user's answer, verbatim where it matters" }
        }
      }
    },

    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "description": "a resume re-hashes each of these. a changed hash invalidates that artifact and every phase downstream of it.",
      "properties": {
        "brief":        { "$ref": "#/$defs/artifact" },
        "recon":        { "$ref": "#/$defs/artifact" },
        "requirements": { "$ref": "#/$defs/dual_artifact" },
        "architecture": { "$ref": "#/$defs/dual_artifact" },
        "tasks":        { "$ref": "#/$defs/artifact" }
      }
    },

    "waves": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["index", "status", "task_ids"],
        "additionalProperties": false,
        "properties": {
          "index": { "type": "integer", "minimum": 0 },
          "status": { "type": "string", "enum": ["pending", "dispatched", "accepted", "integrated", "failed"] },
          "task_ids": { "type": "array", "items": { "type": "string" } },
          "dispatched_at": { "type": "string", "format": "date-time" },
          "merge_commit": { "type": "string" },
          "integration_result": { "type": "string", "description": "the command and its observed outcome" },
          "review_result": { "type": "string" },
          "conflicts_resolved": {
            "type": "array",
            "items": { "type": "string" },
            "description": "path, and which contract clause decided the resolution"
          }
        }
      }
    },

    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "class", "summary", "owner", "status"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "class": {
            "type": "string",
            "enum": ["task-defect", "contract-defect", "environment", "external", "product-choice", "approval"]
          },
          "summary": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "enum": ["user", "orchestrator", "task-agent"] },
          "status": { "type": "string", "enum": ["open", "resolved"] },
          "task_id": { "type": "string" },
          "recommended": { "type": "string", "description": "the option the orchestrator recommends, so the user answers rather than investigates" }
        }
      }
    }
  },

  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["path", "sha256", "approved"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "approved": { "type": "boolean" }
      }
    },
    "dual_artifact": {
      "type": "object",
      "required": ["html", "md"],
      "additionalProperties": false,
      "properties": {
        "html": { "$ref": "#/$defs/artifact" },
        "md": { "$ref": "#/$defs/artifact" }
      }
    }
  }
}
