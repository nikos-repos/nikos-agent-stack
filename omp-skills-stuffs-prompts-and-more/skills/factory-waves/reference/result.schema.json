{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.factory/schemas/result.schema.json",
  "title": "factory task result",
  "description": "the immutable evidence from one task plus the acceptance gate verdict used by resume.",
  "$ref": "#/$defs/persisted_result",
  "$defs": {
    "agent_result_fields": {
      "type": "object",
      "required": [
        "task_id",
        "status",
        "changed_files",
        "probe_log_path",
        "acceptance_results",
        "commands_run",
        "tests_written",
        "tests_omitted",
        "commit",
        "blocker"
      ],
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^[0-9]{2}-[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "the stable task id from the task graph."
        },
        "status": {
          "type": "string",
          "enum": ["complete", "blocked", "failed"]
        },
        "changed_files": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 },
          "description": "the exact changed-file manifest returned by the task agent."
        },
        "probe_log_path": {
          "type": "string",
          "minLength": 1,
          "description": "the task worktree probe log path."
        },
        "acceptance_results": {
          "type": "array",
          "items": { "$ref": "#/$defs/acceptance_result" },
          "description": "the task agent's evidence for each acceptance criterion."
        },
        "commands_run": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "commands run by the task agent."
        },
        "tests_written": {
          "type": "integer",
          "minimum": 0
        },
        "tests_omitted": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "tests not run and the reason for each omission."
        },
        "commit": {
          "type": "string",
          "description": "the task branch commit returned by the task agent."
        },
        "blocker": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/$defs/blocker" }
          ]
        }
      }
    },
    "agent_result": {
      "allOf": [
        { "$ref": "#/$defs/agent_result_fields" }
      ],
      "unevaluatedProperties": false,
      "description": "the strict task-agent result returned by a wave task call."
    },
    "persisted_result": {
      "allOf": [
        { "$ref": "#/$defs/agent_result_fields" },
        {
          "type": "object",
          "required": [
            "verdict",
            "failure_class",
            "reason",
            "checks"
          ],
          "properties": {
            "verdict": {
              "type": "string",
              "enum": ["pass", "fail"],
              "description": "the acceptance gate verdict."
            },
            "failure_class": {
              "type": ["string", "null"],
              "enum": [
                "task defect",
                "contract defect",
                "environment defect",
                "external blocker",
                null
              ],
              "description": "the required gate failure class, or null for a passing verdict."
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "description": "why the gate returned this verdict."
            },
            "contributing_factors": {
              "type": "array",
              "items": { "$ref": "#/$defs/contributing_factor" },
              "description": "optional, non-authoritative. conditions that jointly produced a failing verdict, beyond the single routing failure_class. diagnostic only: it is not a check, not a verdict property, and it never selects the failure route."
            },
            "checks": {
              "type": "array",
              "minItems": 6,
              "maxItems": 6,
              "items": { "$ref": "#/$defs/check" },
              "allOf": [
                {
                  "contains": {
                    "allOf": [
                      { "$ref": "#/$defs/check" },
                      { "properties": { "name": { "const": "identity" } } }
                    ]
                  },
                  "minContains": 1,
                  "maxContains": 1
                },
                {
                  "contains": {
                    "allOf": [
                      { "$ref": "#/$defs/check" },
                      { "properties": { "name": { "const": "ownership" } } }
                    ]
                  },
                  "minContains": 1,
                  "maxContains": 1
                },
                {
                  "contains": {
                    "allOf": [
                      { "$ref": "#/$defs/check" },
                      { "properties": { "name": { "const": "probe-log" } } }
                    ]
                  },
                  "minContains": 1,
                  "maxContains": 1
                },
                {
                  "contains": {
                    "allOf": [
                      { "$ref": "#/$defs/check" },
                      { "properties": { "name": { "const": "acceptance" } } }
                    ]
                  },
                  "minContains": 1,
                  "maxContains": 1
                },
                {
                  "contains": {
                    "allOf": [
                      { "$ref": "#/$defs/check" },
                      { "properties": { "name": { "const": "budget" } } }
                    ]
                  },
                  "minContains": 1,
                  "maxContains": 1
                },
                {
                  "contains": {
                    "allOf": [
                      { "$ref": "#/$defs/check" },
                      { "properties": { "name": { "const": "cadence" } } }
                    ]
                  },
                  "minContains": 1,
                  "maxContains": 1
                }
              ],
              "description": "one result and evidence entry for each acceptance gate check."
            }
          }
        },
        {
          "if": {
            "properties": { "verdict": { "const": "pass" } },
            "required": ["verdict"]
          },
          "then": {
            "properties": { "failure_class": { "type": "null" } },
            "not": {
              "properties": {
                "checks": {
                  "contains": {
                    "allOf": [
                      { "$ref": "#/$defs/check" },
                      { "properties": { "result": { "const": "fail" } } }
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": { "verdict": { "const": "fail" } },
            "required": ["verdict"]
          },
          "then": {
            "properties": {
              "failure_class": {
                "type": "string",
                "enum": [
                  "task defect",
                  "contract defect",
                  "environment defect",
                  "external blocker"
                ]
              },
              "checks": {
                "contains": {
                  "allOf": [
                    { "$ref": "#/$defs/check" },
                    { "properties": { "result": { "const": "fail" } } }
                  ]
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false,
      "description": "the strict persisted result written by the acceptance gate."
    },
    "acceptance_result": {
      "type": "object",
      "required": ["criterion", "result", "evidence"],
      "additionalProperties": false,
      "properties": {
        "criterion": { "type": "string", "minLength": 1 },
        "result": { "type": "string", "enum": ["pass", "fail"] },
        "evidence": { "type": "string", "minLength": 1 }
      }
    },
    "blocker": {
      "type": "object",
      "required": ["type", "reason"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "details": { "type": "string", "minLength": 1 }
      }
    },
    "contributing_factor": {
      "type": "object",
      "required": ["factor", "evidence"],
      "additionalProperties": false,
      "properties": {
        "factor": {
          "type": "string",
          "enum": [
            "task defect",
            "contract defect",
            "environment defect",
            "external blocker"
          ],
          "description": "a condition that contributed to the failure. the same vocabulary as failure_class, used here without authority."
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "description": "the observation that supports this factor."
        }
      },
      "description": "one contributing condition recorded beside the authoritative failure_class."
    },
    "check": {
      "type": "object",
      "required": ["name", "result", "evidence"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "enum": ["identity", "ownership", "probe-log", "acceptance", "budget", "cadence"]
        },
        "result": { "type": "string", "enum": ["pass", "fail"] },
        "evidence": { "type": "string", "minLength": 1 }
      }
    }
  }
}
