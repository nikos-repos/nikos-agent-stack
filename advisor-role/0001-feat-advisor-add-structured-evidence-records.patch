 				{ note: "named note", advisor: 'Arch "X"' },
@@ -5406,6 +5451,35 @@ describe("advisor", () => {
 			expect(text).not.toContain("[default]");
 		});
 
+		it("renders structured evidence without terminal control sequences", async () => {
+			const uiTheme = await getThemeByName("dark");
+			if (!uiTheme) throw new Error("theme unavailable");
+			const terminalTitle = "\u001b]0;owned\u0007";
+			const card = createAdvisorMessageCard(
+				{
+					notes: [
+						{
+							note: "expired tokens can pass",
