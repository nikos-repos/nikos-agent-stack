+				note: "x",
+				evidence: { path: "src/auth.ts", line: 0, claim: "expired tokens pass", digest: "a1b2" },
+			});
+			expect(invalidEvidence instanceof type.errors).toBe(true);
 		});
 	});
 
@@ -827,6 +853,25 @@ describe("advisor", () => {
 			expect(content.split('severity="').length - 1).toBe(1);
 		});
 
+		it("serializes structured evidence with escaped attributes and claim text", () => {
+			const content = formatAdvisorBatchContent([
+				{
+					note: "inspect the cited branch",
