From: nikos-repos <nikobono43@gmail.com>
Date: Thu, 13 Aug 2026 02:10:19 -0500
Subject: [PATCH] feat(advisor): add structured evidence records

---
 .../coding-agent/src/advisor/advise-tool.ts   | 43 ++++++++--
 .../src/modes/components/advisor-message.ts   | 13 +++
 .../src/prompts/advisor/advise-tool.md        |  1 +
 .../src/session/session-advisors.ts           | 11 ++-
 .../coding-agent/test/advisor/advisor.test.ts | 82 ++++++++++++++++++-
 5 files changed, 136 insertions(+), 14 deletions(-)

diff --git a/packages/coding-agent/src/advisor/advise-tool.ts b/packages/coding-agent/src/advisor/advise-tool.ts
index d9cb954..57ebb95 100644
--- a/packages/coding-agent/src/advisor/advise-tool.ts
+++ b/packages/coding-agent/src/advisor/advise-tool.ts
@@ -15,15 +15,29 @@ const adviseSchema = type({
 		"One concrete piece of advice for the agent you are watching. Terse, specific, actionable.",
 	),
 	"severity?": type("'nit' | 'concern' | 'blocker'").describe("How strongly to weigh this. Omit for a plain nit."),
+	"evidence?": {
+		path: type("string > 0").describe("Inspected file path supporting this advice."),
+		line: type("number.integer >= 1").describe("One-indexed supporting source line."),
+		claim: type("string > 0").describe("Concrete claim established by the cited source."),
+		digest: type("string > 0").describe("Digest identifying the inspected file snapshot."),
+	},
 });
 
 export type AdviseParams = typeof adviseSchema.infer;
 
 export type AdvisorSeverity = "nit" | "concern" | "blocker";
 
+export interface AdvisorEvidence {
+	path: string;
+	line: number;
+	claim: string;
+	digest: string;
+}
+
 export interface AdviseDetails {
 	note: string;
 	severity?: AdvisorSeverity;
+	evidence?: AdvisorEvidence;
 	/** Which configured advisor produced this note (omitted for the default advisor). */
 	advisor?: string;
 }
@@ -32,6 +46,7 @@ export interface AdviseDetails {
 export interface AdvisorNote {
 	note: string;
 	severity?: AdvisorSeverity;
+	evidence?: AdvisorEvidence;
 	/** Which configured advisor produced this note (omitted for the default advisor). */
 	advisor?: string;
 }
@@ -60,7 +75,10 @@ export function formatAdvisorBatchContent(notes: readonly AdvisorNote[]): string
 		.map(n => {
 			const severity = n.severity ? ` severity="${n.severity}"` : "";
 			const who = n.advisor ? ` advisor="${escapeXmlAttribute(n.advisor)}"` : "";
-			return `<advisory${who}${severity} guidance="${ADVISOR_GUIDANCE}">\n${escapeXmlText(n.note)}\n</advisory>`;
+			const evidence = n.evidence
+				? `\n<evidence path="${escapeXmlAttribute(n.evidence.path)}" line="${n.evidence.line}" digest="${escapeXmlAttribute(n.evidence.digest)}">\n${escapeXmlText(n.evidence.claim)}\n</evidence>`
+				: "";
+			return `<advisory${who}${severity} guidance="${ADVISOR_GUIDANCE}">\n${escapeXmlText(n.note)}${evidence}\n</advisory>`;
 		})
 		.join("\n");
 }
@@ -169,6 +187,12 @@ function advisorSeverityRank(severity: AdvisorSeverity | undefined): number {
 	return ADVISOR_SEVERITY_RANK[severity ?? "nit"];
 }
 
+function adviseDetails(args: AdviseParams): AdviseDetails {
+	const details: AdviseDetails = { note: args.note, severity: args.severity };
+	if (args.evidence) details.evidence = args.evidence;
+	return details;
+}
+
 export class AdviseTool implements AgentTool<typeof adviseSchema, AdviseDetails> {
 	readonly name = "advise";
 	readonly label = "Advise";
@@ -182,7 +206,13 @@ export class AdviseTool implements AgentTool<typeof adviseSchema, AdviseDetails>
 	#deliveredNoteSeverities = new Map<string, number>();
 	#inProgressUpdate = false;
 
-	constructor(private readonly onAdvice: (note: string, severity?: AdviseDetails["severity"]) => void) {}
+	constructor(
+		private readonly onAdvice: (
+			note: string,
+			severity?: AdviseDetails["severity"],
+			evidence?: AdvisorEvidence,
+		) => void,
+	) {}
 
 	/**
 	 * Mark whether the next advisor prompt reviews an in-progress primary turn.
@@ -209,7 +239,7 @@ export class AdviseTool implements AgentTool<typeof adviseSchema, AdviseDetails>
 		if (this.#inProgressUpdate && args.severity !== "blocker") {
 			return {
 				content: [{ type: "text", text: "Recorded." }],
-				details: { note: args.note, severity: args.severity },
+				details: adviseDetails(args),
 				useless: true,
 			};
 		}
@@ -219,15 +249,16 @@ export class AdviseTool implements AgentTool<typeof adviseSchema, AdviseDetails>
 		if (rank <= previousRank) {
 			return {
 				content: [{ type: "text", text: "Duplicate advice ignored." }],
-				details: { note: args.note, severity: args.severity },
+				details: adviseDetails(args),
 				useless: true,
 			};
 		}
 		this.#deliveredNoteSeverities.set(key, rank);
-		this.onAdvice(args.note, args.severity);
+		if (args.evidence) this.onAdvice(args.note, args.severity, args.evidence);
+		else this.onAdvice(args.note, args.severity);
 		return {
 			content: [{ type: "text", text: "Recorded." }],
-			details: { note: args.note, severity: args.severity },
+			details: adviseDetails(args),
 			useless: true,
 		};
 	}
