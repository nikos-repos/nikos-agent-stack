 } from "../../tools/render-utils";
 import { Ellipsis, truncateToWidth } from "../../tui";
+import { sanitizeStatusText } from "../shared";
 import type { Theme } from "../theme/theme";
 
 const COLLAPSED_NOTES = 3;
@@ -91,6 +92,18 @@ export function createAdvisorMessageCard(
 						bodyLines.push(...wrapTextWithAnsi(p, w2));
 					}
 				}
+				if (entry.evidence) {
+					bodyLines.push(
+						...wrapTextWithAnsi(
+							`evidence ${replaceTabs(sanitizeStatusText(entry.evidence.path))}:${entry.evidence.line}`,
+							w2,
+						),
+					);
+					bodyLines.push(...wrapTextWithAnsi(replaceTabs(sanitizeStatusText(entry.evidence.claim)), w2));
+					bodyLines.push(
+						...wrapTextWithAnsi(`digest ${replaceTabs(sanitizeStatusText(entry.evidence.digest))}`, w2),
+					);
+				}
 
 				bodyLines.forEach((line, index) => {
 					const prefix = index === 0 ? `${badge}${who}` : "";
diff --git a/packages/coding-agent/src/prompts/advisor/advise-tool.md b/packages/coding-agent/src/prompts/advisor/advise-tool.md
index 144abc3..3600aa0 100644
--- a/packages/coding-agent/src/prompts/advisor/advise-tool.md
+++ b/packages/coding-agent/src/prompts/advisor/advise-tool.md
@@ -1,3 +1,4 @@
 Watched agent: send 1 concrete, terse advice.
 Use sparingly; stay silent when nothing matters.
 Call to avert likely-wrong or materially wasteful work.
+When inspected source supports the advice, attach its path, line, claim, and read-snapshot digest as evidence.
